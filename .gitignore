# Supabase CLI scratch state — never source
supabase/.temp/

# Claude Code: settings.json is shared and reviewed, settings.local.json is not.
# The local file accumulates whatever was clicked through at a prompt — one-off
# compound commands, paths from one machine — so it is per-developer noise
# rather than a decision the house has made.
.claude/settings.local.json

# rtk's own working files. Its filters.toml IS committed: it is project config.
.rtk/cache/
.rtk/*.log

# Vendored Tesco fork — treat as a dependency, do not edit
# (kept in the repo per CLAUDE.md, but its node_modules never are)
lib/tesco/node_modules/

# Locally installed agent skills are independent repositories, not app submodules.
/.agents/skills/impeccable/
/.agents/skills/taste-skill/
