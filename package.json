{
  "name": "housegrocer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test a11y-authenticated.spec.ts",
    "e2e:auth": "playwright codegen --save-storage=.playwright/auth/user.json http://localhost:3002/login",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "audit:launch": "node scripts/launch-audit.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.19.0",
    "headroom-ai": "^0.22.4",
    "next": "^16.3.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "chromium": "^3.0.3",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.47",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^3.4.13",
    "ts-jest": "^29.4.12",
    "typescript": "^5.6.3"
  },
  "description": "",
