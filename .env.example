# Supabase — both required. NEXT_PUBLIC_ prefix is fine: this is the anon/publishable
# key, not the service_role key, and RLS is what actually keeps data safe.
NEXT_PUBLIC_SUPABASE_URL=https://wljozmmcfbonufpqjgjk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_g9WmyuYPhXhLjmDhG8kaQw_2yhYONPZ

# Push notifications — optional. Unset, the subscribe flow just no-ops.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Tesco account operations are enabled automatically in development and disabled
# by default in production. Set this only on a host that can run the ordering
# runtime; standard Vercel serverless functions cannot run the Playwright flow.
# TESCO_ORDERING_ENABLED=true
